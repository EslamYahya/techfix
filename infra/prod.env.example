# Copy to infra/prod.env (never commit it). Every value below must be replaced.
POSTGRES_PASSWORD=
# openssl rand -base64 48
JWT_ACCESS_SECRET=
# The public address of the web app, e.g. https://app.example.com (no trailing slash)
CORS_ORIGIN=
LOG_LEVEL=info

# First administrator, created by the seed command (see docs/ops/runbook.md)
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=

# Online payment (leave empty to run cash-only)
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=
FAWRY_BASE_URL=
FAWRY_WEBHOOK_URL=
