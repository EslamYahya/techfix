{
  "name": "@techfix/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "seed": "tsx src/scripts/seed.ts",
    "worker": "tsx src/worker.ts",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --no-file-parallelism",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@techfix/contracts": "workspace:*",
    "@techfix/db": "workspace:*",
    "@techfix/domain": "workspace:*",
    "bullmq": "^5.81.5",
    "helmet": "^8.0.0",
    "jose": "^6.0.0",
    "nestjs-pino": "^5.0.0",
    "pg": "^8.13.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.0",
    "@swc/core": "^1.10.0",
    "@techfix/config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.2.0"
  }
}
