# Copy to .env — never commit real secrets
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://techfix:techfix@localhost:5434/techfix
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-min-32-chars-change-me-0001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=techfix
S3_ACCESS_KEY=techfix
S3_SECRET_KEY=techfix-secret
CORS_ORIGIN=http://localhost:5173
SEED_ADMIN_PHONE=01000000000
SEED_ADMIN_PASSWORD=change-me-admin

# --- Online payment: Fawry (leave all empty to run cash-only) ---
# Get these from Fawry's merchant portal. NEVER commit real values.
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=
# Sandbox: https://atfawry.fawrystaging.com   Production: the URL Fawry gives you at go-live
FAWRY_BASE_URL=
# Public URL of POST /api/v1/payments/webhook (optional if set in Fawry's portal)
FAWRY_WEBHOOK_URL=
PAYMENT_EXPIRY_HOURS=24
PAYMENT_RECONCILE_AFTER_MINUTES=30

# --- Notifications & background jobs (phase 5) ---
# With REDIS_URL set the API uses BullMQ; without it jobs run in-process (fine for local dev).
# REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=techfix
# true = this process also runs the schedules. Run ONE `pnpm --filter @techfix/api worker` (or leave true
# on a single API instance) and set false on the other API replicas.
RUN_WORKERS=true
OUTBOX_SWEEP_INTERVAL_SECONDS=15
PAYMENT_RECONCILE_INTERVAL_MINUTES=10

# --- Production (see docs/ops) ---
# Number of reverse proxies in front of the API (nginx in infra/docker = 1). 0 in local development.
TRUST_PROXY=0
